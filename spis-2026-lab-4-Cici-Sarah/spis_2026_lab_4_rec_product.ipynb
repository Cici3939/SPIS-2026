      "source": [
        "def rec_product(a, b):\n",
        "  \"\"\" Calculate product a * b recursively \"\"\"\n",
        "  if b == 0:\n",
        "    return 0\n",
        "  elif b < 0:\n",
        "    return rec_product(a,b+1) - a\n",
        "  else:\n",
        "    return rec_product(a,b-1) + a\n",
        "\n",
        "print(rec_product(5,5))\n",
        "print(rec_product(1,-5))\n",
        "print(rec_product(-1,-5))"
      ]
    }
  ]
}